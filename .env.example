ADDR="127.0.0.1:8080"
# Docker logs print this address after the server becomes healthy.
PUBLIC_URL="https://nas.tryplusit.com"
ADMIN_PASSWORD="replace-with-a-strong-random-password"
ADMIN_USER="admin"
COOKIE_SECURE="false"
CORS_ORIGIN="http://localhost:3000,http://192.168.0.16:3000"
DB_PATH="./data/trynas.db"
NEXT_PUBLIC_API_URL="http://localhost:8080"
STORAGE_ROOT="./storage"

# For direct HTTPS, configure both certificate files. Cookies become Secure automatically.
# TLS_CERT_FILE="/path/to/fullchain.pem"
# TLS_KEY_FILE="/path/to/privkey.pem"
# Behind HTTPS proxies, set COOKIE_SECURE=true and trust only the proxy socket IP.
# TRUSTED_PROXIES="127.0.0.1,::1"

# Upload proxy limit in MiB (1–10240). Settings can update this value.
PROXY_UPLOAD_LIMIT_MB="10240"
