[Unit]
# User unit: install into ~/.config/systemd/user/trynas.service.
# Use systemctl --user; %h resolves to this user's actual home directory.
Description=TryNAS web UI and API
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%h/trynas
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/trynas
ExecStart="%h/.local/bin/trynas" -config "%h/trynas/.env"
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trynas

[Install]
WantedBy=default.target
